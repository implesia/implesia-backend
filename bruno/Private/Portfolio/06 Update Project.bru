meta {
  name: Update Project
  type: http
  seq: 6
}

patch {
  url: {{PRIVATE_BASE_URL}}/api/v1/admin/portfolio/projects/{{PROJECT_ID}}
  body: multipartForm
  auth: none
}

body:multipart-form {
  status: Completed
  is_published: true
  ~image: @file(fixtures/portfolio-card.png)
}

settings {
  encodeUrl: true
  timeout: 0
}
